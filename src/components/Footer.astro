---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="brand">
        <img class="brand-mark" src="/images/logo.png" alt="Caroma — since 1976" width="150" height="75" />
      </a>
      <p>Malaysian beverages since 1976 — coffee, tea, Japanese matcha and Bentong ginger, where taste meets innovation in every sip.</p>
      <div class="socials">
        <a href="#" aria-label="Facebook">Facebook</a>
        <a href="#" aria-label="Instagram">Instagram</a>
        <a href="#" aria-label="Shopee">Shopee</a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <a href="/">Home</a>
      <a href="/about">About Us</a>
      <a href="/products">Products</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <h4>Our Range</h4>
      <a href="/products">Coffee</a>
      <a href="/products">Tea</a>
      <a href="/products">Matcha & Japanese</a>
      <a href="/products">Bentong Ginger</a>
    </div>

    <div class="footer-col">
      <h4>Get in touch</h4>
      <p class="muted">No. 5, Jalan Tembaga SD5/2d, Bandar Sri Damansara, 52200 Kuala Lumpur, Malaysia</p>
      <a href="mailto:sales@caroma.com.my">sales@caroma.com.my</a>
      <a href="mailto:mart@caroma.com.my">mart@caroma.com.my</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© {year} Caroma · Co. No. 548399-M · Since 1976</span>
    <span>Kuala Lumpur, Malaysia</span>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--navy);
    color: #D8DECF;
    margin-top: 110px;
    padding: 70px 0 30px;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.7fr 1fr 1fr 1.4fr;
    gap: 40px;
  }
  .brand { display: inline-flex; align-items: center; gap: 13px; margin-bottom: 18px; background: #fff; padding: 12px 16px; border-radius: 12px; }
  .brand-mark { height: 50px; width: auto; object-fit: contain; }
  .footer-brand p { color: #A9B49C; max-width: 320px; font-size: .95rem; line-height: 1.6; }

  .socials { display: flex; gap: 18px; margin-top: 22px; }
  .socials a {
    font-size: .88rem; font-weight: 500; color: #A9B49C;
    transition: color .2s ease;
  }
  .socials a:hover { color: var(--gold); }

  .footer-col h4 {
    font-family: var(--font-display); font-size: .8rem; letter-spacing: .12em; text-transform: uppercase;
    margin-bottom: 18px; color: #8A957C;
  }
  .footer-col a { display: block; color: #D8DECF; padding: 6px 0; font-size: .95rem; transition: color .18s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-col .muted { color: #A9B49C; margin-bottom: 14px; font-size: .95rem; line-height: 1.6; }

  .footer-bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    margin-top: 54px; padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.08);
    color: #8A957C; font-size: .86rem;
  }

  @media (max-width: 860px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; gap: 30px; }
  }
</style>
