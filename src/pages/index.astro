---
import Layout from "../layouts/Layout.astro";
import Wave from "../components/Wave.astro";

const featured = [
  { img: "/images/products/product-6529013.png", name: "Uji Matcha Latte 3-in-1", cat: "Matcha & Japanese" },
  { img: "/images/products/product-3574722.png", name: "Blende White Coffee 3-in-1", cat: "Coffee" },
  { img: "/images/products/product-5788819.png", name: "Hong Kong Style Milk Tea", cat: "Tea" },
  { img: "/images/products/product-3574546.png", name: "Bentong Ginger with Tea", cat: "Ginger & Wellness" },
  { img: "/images/products/product-3682004.png", name: "Pure Green Tea Matcha Powder", cat: "Matcha & Japanese" },
  { img: "/images/products/product-4530783.png", name: "Bundle Set — Teh Tarik", cat: "Bundles" },
];

const collections = [
  { img: "/images/products/product-3717039.png", tag: "Coffee", h: "Local kopi, done right", p: "Kopi O, Kopi C Kosong, white coffee and roasted blends — the taste of the Malaysian kopitiam.", color: "var(--navy)" },
  { img: "/images/products/product-6529059.png", tag: "Matcha", h: "Uji matcha, direct from Japan", p: "Matcha, hojicha and genmaicha lattes and powders sourced from Uji, Japan.", color: "var(--red)" },
];

const quality = [
  { k: "Since 1976", v: "Nearly five decades crafting Malaysian beverages." },
  { k: "Bentong ginger", v: "Premium soilless Bentong ginger in our wellness range." },
  { k: "Wholesale & OEM", v: "Private label and volume supply for retailers and HoReCa." },
];
---

<Layout path="/">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy" data-hero-stagger>
        <span class="eyebrow">Malaysian Beverages · Since 1976</span>
        <h1 data-split>The art of beverage perfection.</h1>
        <p class="hero-lead">
          Caroma blends innovation with exquisite flavour — coffee, tea, Japanese matcha and
          Bentong ginger drinks, crafted in Malaysia for every moment of refreshment.
        </p>
        <div class="hero-actions">
          <a href="/products" class="btn btn-primary">Shop the range
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a href="/about" class="btn btn-ghost">Our story</a>
        </div>
        <p class="hero-trust">Coffee · Tea · Matcha · Bentong Ginger — <strong>made in Malaysia</strong>.</p>
      </div>

      <div class="hero-art" data-hero-art>
        <div class="hero-img-main">
          <img src="/images/products/product-6529013.png" alt="Caroma Uji Matcha Latte" width="620" height="520" />
        </div>
        <figure class="hero-float">
          <img src="/images/products/product-3574546.png" alt="Bentong Ginger with Tea" width="280" height="200" />
          <figcaption>Bentong Ginger · A wellness favourite</figcaption>
        </figure>
        <div class="hero-badge">
          <span>Since<br><strong>1976</strong></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TICKER ============ -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      <span>Coffee</span><i></i><span>Hong Kong Milk Tea</span><i></i><span>Uji Matcha</span><i></i>
      <span>Bentong Ginger</span><i></i><span>Teh Tarik</span><i></i><span>Hojicha</span><i></i>
      <span>Coffee</span><i></i><span>Hong Kong Milk Tea</span><i></i><span>Uji Matcha</span><i></i>
      <span>Bentong Ginger</span><i></i><span>Teh Tarik</span><i></i><span>Hojicha</span><i></i>
    </div>
  </div>

  <!-- ============ COLLECTIONS ============ -->
  <section class="brands">
    <div class="container">
      <header class="sec-head" data-reveal>
        <div>
          <span class="eyebrow">Signature ranges</span>
          <h2 class="section-title">From kopitiam to Kyoto</h2>
        </div>
        <p class="section-lead">Two worlds of flavour — Malaysian classics and authentic Japanese green tea.</p>
      </header>

      <div class="brand-grid" data-reveal-group>
        {collections.map((c) => (
          <article class="brand-card">
            <div class="brand-media"><img src={c.img} alt={c.h} loading="lazy" /></div>
            <div class="brand-body">
              <span class="brand-tag" style={`color:${c.color}`}>{c.tag}</span>
              <h3>{c.h}</h3>
              <p>{c.p}</p>
              <a href="/products" class="textlink">View range →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FEATURED ============ -->
  <section class="featured">
    <div class="container">
      <header class="sec-head row" data-reveal>
        <div>
          <span class="eyebrow">Best sellers</span>
          <h2 class="section-title">Customer favourites</h2>
        </div>
        <a href="/products" class="btn btn-ghost">All products
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </header>

    </div>

    <div class="pin-wrap" data-pin-wrap>
      <div class="pin-track" data-pin-track>
        {featured.map((p, i) => (
          <a href="/products" class="pin-card">
            <span class="pin-index">{String(i + 1).padStart(2, "0")}</span>
            <div class="pin-media"><img src={p.img} alt={p.name} loading="lazy" /></div>
            <div class="pin-info">
              <span class="prod-cat">{p.cat}</span>
              <h3>{p.name}</h3>
            </div>
          </a>
        ))}
        <a href="/products" class="pin-card pin-card-cta">
          <span>See all<br>products</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ WHY ============ -->
  <section class="quality">
    <div class="container quality-grid">
      <div class="quality-media" data-reveal>
        <div class="quality-frame">
          <img src="/images/products/product-5788819.png" alt="Caroma Hong Kong Style Milk Tea" width="560" height="600" loading="lazy" data-parallax="-26" />
        </div>
        <div class="quality-stat" data-parallax="22">
          <span class="num"><span data-count="48">0</span>+</span>
          <span class="lbl">years crafting<br>Malaysian drinks</span>
        </div>
      </div>
      <div class="quality-copy" data-reveal>
        <span class="eyebrow">Why Caroma</span>
        <h2 class="section-title">Where taste meets innovation</h2>
        <p class="section-lead">Since 1976 we've blended tradition with new ideas — bringing you a diverse range of high-quality, convenient and delicious beverages, in every sip.</p>
        <ul class="quality-list" data-scrub>
          {quality.map((q) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M20 6L9 17l-5-5"/></svg>
              <div><strong>{q.k}</strong><span>{q.v}</span></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .accent { color: var(--red); }
  .textlink { font-weight: 600; color: var(--red); font-size: .95rem; }
  .textlink:hover { color: var(--red-deep); }

  /* ---------- HERO ---------- */
  .hero { padding: 72px 0 90px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 56px; align-items: center; }
  .hero-copy h1 { font-size: clamp(2.9rem, 6vw, 4.6rem); margin: 22px 0 22px; letter-spacing: -0.04em; }
  .hero-lead { font-size: 1.15rem; color: var(--ink-soft); max-width: 510px; line-height: 1.65; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 32px 0 26px; }
  .hero-trust { font-size: .95rem; color: var(--ink-soft); }
  .hero-trust strong { color: var(--ink); font-weight: 700; }

  .hero-art { position: relative; }
  .hero-img-main { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--shadow-md); aspect-ratio: 6 / 5; background: var(--cream); display: grid; place-items: center; }
  .hero-img-main img { width: 84%; height: 84%; object-fit: contain; }
  .hero-float { position: absolute; left: -28px; bottom: -28px; width: 230px; background: #fff; border-radius: 16px; padding: 10px; box-shadow: var(--shadow-md); }
  .hero-float img { width: 100%; border-radius: 9px; aspect-ratio: 7/5; object-fit: contain; background: var(--cream); }
  .hero-float figcaption { font-size: .76rem; font-weight: 600; color: var(--ink-soft); padding: 8px 4px 4px; }
  .hero-badge { position: absolute; top: -22px; right: -18px; display: flex; align-items: center; gap: 10px; background: var(--navy); color: #fff; padding: 12px 16px; border-radius: 14px; box-shadow: var(--shadow-md); }
  .hero-badge span { font-family: var(--font-display); font-size: .72rem; line-height: 1.1; letter-spacing: .04em; }
  .hero-badge strong { font-size: 1.05rem; color: var(--gold); }

  /* ---------- TICKER ---------- */
  .ticker { background: var(--navy); overflow: hidden; padding: 15px 0; }
  .ticker-track { display: flex; align-items: center; gap: 28px; white-space: nowrap; width: max-content; animation: scroll 30s linear infinite; }
  .ticker-track span { font-family: var(--font-display); font-weight: 600; font-size: .92rem; text-transform: uppercase; letter-spacing: .14em; color: rgba(255,255,255,.92); }
  .ticker-track i { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); display: inline-block; }
  @keyframes scroll { to { transform: translateX(-50%); } }

  /* ---------- shared section header ---------- */
  .brands, .featured { padding: 100px 0 0; }
  .sec-head { margin-bottom: 48px; }
  .sec-head.row { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; }
  .brands .sec-head { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; align-items: end; }
  .brands .sec-head .section-lead { margin-top: 0; }

  /* ---------- COLLECTIONS ---------- */
  .brand-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .brand-card { display: block; }
  .brand-media { overflow: hidden; border-radius: 28px; background: var(--cream); box-shadow: 0 0 0 rgba(32,39,31,0); transition: transform .4s cubic-bezier(.2,.8,.25,1), box-shadow .4s ease; }
  .brand-media img { width: 100%; aspect-ratio: 16/10; object-fit: contain; padding: 24px; transition: transform .6s cubic-bezier(.2,.8,.25,1); }
  .brand-card:hover .brand-media { transform: translateY(-8px); box-shadow: var(--shadow-md); }
  .brand-card:hover .brand-media img { transform: scale(1.05); }
  .brand-body { padding: 24px 6px 0; }
  .brand-tag { display: inline-block; font-weight: 600; font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; }
  .brand-body h3 { font-size: 1.6rem; margin-bottom: 10px; letter-spacing: -0.03em; }
  .brand-body p { color: var(--ink-soft); font-size: 1rem; margin-bottom: 16px; max-width: 440px; }

  /* ---------- FEATURED ---------- */
  .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 34px; }
  .prod-card { display: block; }
  .prod-media { aspect-ratio: 1/1; overflow: hidden; border-radius: 26px; background: #fff; border: 1px solid var(--line); box-shadow: 0 0 0 rgba(32,39,31,0); transition: transform .4s cubic-bezier(.2,.8,.25,1), box-shadow .4s ease; }
  .prod-media img { width: 100%; height: 100%; object-fit: contain; padding: 16px; transition: transform .6s cubic-bezier(.2,.8,.25,1); }
  .prod-card:hover .prod-media { transform: translateY(-12px); box-shadow: 0 26px 44px rgba(47,122,58,.16); }
  .prod-card:hover .prod-media img { transform: scale(1.07); }
  .prod-info { padding: 18px 6px 0; }
  .prod-cat { font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }
  .prod-info h3 { font-size: 1.08rem; margin-top: 6px; letter-spacing: -0.02em; transition: color .25s ease; display: inline-flex; align-items: center; gap: 6px; }
  .prod-info h3::after { content: "→"; font-size: .95rem; opacity: 0; transform: translateX(-6px); transition: opacity .25s ease, transform .25s ease; color: var(--red); }
  .prod-card:hover .prod-info h3 { color: var(--red); }
  .prod-card:hover .prod-info h3::after { opacity: 1; transform: translateX(0); }

  /* ---------- WHY ---------- */
  .quality { padding: 110px 0 0; }
  .quality-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 60px; align-items: center; }
  .quality-media { position: relative; }
  .quality-frame { border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 14/15; box-shadow: var(--shadow-md); background: var(--cream); display: grid; place-items: center; }
  .quality-frame img { width: 84%; height: 84%; object-fit: contain; }
  .quality-stat { position: absolute; right: -22px; bottom: 32px; z-index: 2; background: var(--red); color: #fff; border-radius: 16px; padding: 18px 22px; box-shadow: 0 18px 40px rgba(47,122,58,.3); display: flex; align-items: center; gap: 12px; }
  .quality-stat .num { font-family: var(--font-display); font-weight: 700; font-size: 2.4rem; line-height: 1; }
  .quality-stat .lbl { font-size: .82rem; line-height: 1.25; opacity: .95; }
  .quality-copy .section-title { font-size: clamp(1.8rem, 3.6vw, 2.7rem); }
  .quality-list { margin-top: 28px; display: grid; gap: 16px; }
  .quality-list li { display: flex; gap: 14px; align-items: flex-start; }
  .quality-list svg { width: 22px; height: 22px; color: var(--red); flex-shrink: 0; margin-top: 2px; }
  .quality-list strong { display: block; font-family: var(--font-display); font-size: 1.02rem; margin-bottom: 2px; }
  .quality-list span { color: var(--ink-soft); font-size: .96rem; }

  /* ---------- CTA ---------- */
  .cta-box { display: flex; justify-content: space-between; align-items: center; gap: 36px; flex-wrap: wrap; }
  .cta-box h2 { color: #fff; font-size: clamp(1.8rem, 3.6vw, 2.7rem); margin-bottom: 12px; }
  .cta-box p { color: rgba(255,255,255,.8); max-width: 460px; }
  .cta-box .btn { flex-shrink: 0; }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; gap: 70px; }
    .hero-art { max-width: 520px; }
    .quality-grid { grid-template-columns: 1fr; gap: 40px; }
    .quality-media { max-width: 460px; }
    .prod-grid { grid-template-columns: 1fr 1fr; }
    .brand-grid { grid-template-columns: 1fr; }
    .brands .sec-head { grid-template-columns: 1fr; gap: 14px; }
  }
  @media (max-width: 560px) {
    .prod-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
  }
  /* ---------- FEATURED — pinned horizontal strip ---------- */
  .pin-wrap { height: min(72vh, 560px); display: flex; align-items: stretch; overflow: hidden; }
  .pin-track { display: flex; align-items: stretch; gap: 30px; padding: 0 max(28px, calc((100vw - var(--maxw)) / 2 + 28px)); will-change: transform; }
  .pin-card {
    flex: 0 0 auto; width: 330px; position: relative;
    display: flex; flex-direction: column;
    background: var(--white, #fff); border: 1px solid var(--line); border-radius: var(--r-lg);
    box-shadow: var(--shadow-sm); padding: 26px 28px 24px; overflow: hidden;
    transition: box-shadow .4s ease, border-color .4s ease;
  }
  .pin-card:hover { box-shadow: var(--shadow-md); border-color: var(--line-strong); }
  .pin-index { font-family: var(--font-display); font-weight: 800; font-size: 1rem; color: var(--line-strong); }
  .pin-media { flex: 1; min-height: 0; background: var(--cream); border-radius: 18px; margin: 12px 0 18px; overflow: hidden; }
  .pin-media img { width: 100%; height: 100%; object-fit: contain; padding: 22px; transition: transform .6s cubic-bezier(.2,.8,.25,1); }
  .pin-card:hover .pin-media img { transform: scale(1.07); }
  .pin-info .prod-cat { font-size: .72rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }
  .pin-info h3 { font-size: 1.3rem; margin-top: 6px; letter-spacing: -0.02em; }
  .pin-card-cta {
    width: 250px; background: var(--navy); color: #fff; display: flex; flex-direction: column;
    justify-content: center; gap: 16px;
  }
  .pin-card-cta span { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; line-height: 1.1; }
  .pin-card-cta svg { width: 26px; height: 26px; color: var(--gold); }
  .pin-card-cta:hover { background: var(--navy-2); }
  @media (max-width: 760px) {
    .pin-wrap { height: auto; overflow-x: auto; -webkit-overflow-scrolling: touch; padding: 6px 0 20px; scroll-snap-type: x mandatory; }
    .pin-track { padding: 0 20px; }
    .pin-card { width: 78vw; max-width: 320px; scroll-snap-align: center; }
  }
</style>
