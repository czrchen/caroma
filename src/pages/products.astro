---
import Layout from "../layouts/Layout.astro";
import Wave from "../components/Wave.astro";

const filters = [
  { key: "all", label: "All Products" },
  { key: "coffee", label: "Coffee" },
  { key: "tea", label: "Tea" },
  { key: "matcha", label: "Matcha & Japanese" },
  { key: "ginger", label: "Ginger & Wellness" },
  { key: "bundle", label: "Bundles" },
];

const products = [
  { cat: "coffee", name: "Blende White Coffee 3-in-1", img: "/images/products/product-3574722.png" },
  { cat: "coffee", name: "Instant Coffee Powder 500g", img: "/images/products/product-3882501.png" },
  { cat: "coffee", name: "Roasted Coffee Mixture Powder 2kg", img: "/images/products/product-3682061.png" },
  { cat: "coffee", name: "Kopi C Kosong", img: "/images/products/product-3717039.png" },
  { cat: "coffee", name: "Uncang Kopi O Filter Bag", img: "/images/products/product-3717038.png" },
  { cat: "coffee", name: "Hong Kong Style Coffee Powder", img: "/images/products/product-5788817.png" },
  { cat: "tea", name: "Black Tea Teadust 1kg", img: "/images/products/product-5949870.png" },
  { cat: "tea", name: "Hong Kong Style Milk Tea Powder", img: "/images/products/product-5788819.png" },
  { cat: "tea", name: "Hong Kong Style Ice Lemon Tea", img: "/images/products/product-5788818.png" },
  { cat: "tea", name: "Hong Kong Style Yuan Yang Powder", img: "/images/products/product-5788820.png" },
  { cat: "tea", name: "Serbuk Teh Tarik Halia", img: "/images/products/product-3717035.png" },
  { cat: "tea", name: "Serbuk Teh O Halia", img: "/images/products/product-3717037.png" },
  { cat: "matcha", name: "Uji Matcha Latte 3-in-1", img: "/images/products/product-6529013.png" },
  { cat: "matcha", name: "Uji Genmaicha Latte 3-in-1", img: "/images/products/product-6529043.png" },
  { cat: "matcha", name: "Uji Hojicha Latte 3-in-1", img: "/images/products/product-6529059.png" },
  { cat: "matcha", name: "Pure Green Tea Matcha Powder", img: "/images/products/product-3682004.png" },
  { cat: "matcha", name: "Pure Hojicha Roasted Green Tea Powder", img: "/images/products/product-3681998.png" },
  { cat: "matcha", name: "Genmaicha Latte", img: "/images/products/product-5909600.png" },
  { cat: "matcha", name: "Genmaicha Powder", img: "/images/products/product-5909571.png" },
  { cat: "ginger", name: "Bentong Ginger with Tea", img: "/images/products/product-3574546.png" },
  { cat: "ginger", name: "Bentong Ginger with Honey Lemon", img: "/images/products/product-3574561.png" },
  { cat: "ginger", name: "Coconut Water with Bentong Ginger", img: "/images/products/product-3682018.png" },
  { cat: "ginger", name: "Honey with Bentong Ginger", img: "/images/products/product-3682017.png" },
  { cat: "ginger", name: "Pure Soilless Bentong Ginger Powder", img: "/images/products/product-3682013.png" },
  { cat: "ginger", name: "Bentong Ginger with Tea (30's)", img: "/images/products/product-3882412.png" },
  { cat: "ginger", name: "Bentong Ginger with Honey Lemon (30's)", img: "/images/products/product-3882409.png" },
  { cat: "ginger", name: "Organic Soy Powder", img: "/images/products/product-3882511.png" },
  { cat: "bundle", name: "Bundle Set — Teh Tarik", img: "/images/products/product-4530783.png" },
  { cat: "bundle", name: "Twin Pack — Teh Tarik Halia", img: "/images/products/product-4530774.png" },
  { cat: "bundle", name: "Twin Set — Teh O Halia", img: "/images/products/product-4530770.png" },
  { cat: "bundle", name: "Twin Set — Uncang Kopi O", img: "/images/products/product-4530768.png" },
  { cat: "bundle", name: "Twin Set — Kopi C Kosong", img: "/images/products/product-4530766.png" },
];
const labels: Record<string, string> = {
  coffee: "Coffee", tea: "Tea", matcha: "Matcha & Japanese",
  ginger: "Ginger & Wellness", bundle: "Bundle",
};
---

<Layout path="/products" title="Products — Caroma Beverages">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Our products</span>
      <h1 class="page-title" data-reveal>A drink for every moment</h1>
      <p class="page-lead" data-reveal>
        Coffee, tea, Japanese matcha and Bentong ginger — crafted in Malaysia since 1976.
        Filter by category to find your blend.
      </p>
    </div>
  </section>

  <section class="filter-sec">
    <div class="container">
      <div class="filter-bar" data-reveal role="tablist" aria-label="Filter products">
        {filters.map((f, i) => (
          <button class={`filter-btn${i === 0 ? " active" : ""}`} data-filter={f.key}>{f.label}</button>
        ))}
      </div>

      <div class="prod-grid" data-reveal-group>
        {products.map((p) => (
          <article class="pcard" data-cat={p.cat}>
            <div class="pcard-media">
              <img src={p.img} alt={p.name} loading="lazy" width="320" height="320" />
              <span class="pcard-tag">{labels[p.cat]}</span>
            </div>
            <div class="pcard-body"><h3>{p.name}</h3></div>
          </article>
        ))}
      </div>
      <p class="no-results" id="no-results" hidden>No products in this category.</p>
    </div>
  </section>

  <section class="oem ribbon">
    <Wave side="top" />
    <Wave side="bottom" />
    <div class="container ribbon-inner">
      <div class="oem-box" data-reveal>
        <div class="oem-copy">
          <h2>Wholesale, OEM & export</h2>
          <p>Looking to stock Caroma, develop a private-label blend, or order in volume? Our team will help you bring the taste of Malaysia to your customers.</p>
        </div>
        <a href="/contact" class="btn btn-primary">Enquire now
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding: 64px 0 36px; }
  .page-title { font-size: clamp(2.4rem, 5.4vw, 3.8rem); margin: 18px 0 18px; letter-spacing: -0.04em; }
  .page-lead { font-size: 1.12rem; color: var(--ink-soft); max-width: 620px; line-height: 1.65; }

  .filter-sec { padding: 10px 0 0; }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 38px; }
  .filter-btn {
    font-family: var(--font-body); font-weight: 600; font-size: .92rem; cursor: pointer;
    padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: #fff; color: var(--ink-soft); transition: all .2s ease;
  }
  .filter-btn:hover { border-color: var(--gold); color: var(--ink); }
  .filter-btn.active { background: var(--navy); border-color: var(--navy); color: #fff; }

  .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .pcard { display: block; }
  .pcard.is-hidden { display: none; }
  .pcard-media {
    position: relative; aspect-ratio: 1/1; overflow: hidden; border-radius: 22px; background: #fff;
    border: 1px solid var(--line); box-shadow: 0 0 0 rgba(32,39,31,0);
    transition: transform .4s cubic-bezier(.2,.8,.25,1), box-shadow .4s ease;
  }
  .pcard-media img { width: 100%; height: 100%; object-fit: contain; padding: 14px; transition: transform .6s cubic-bezier(.2,.8,.25,1); }
  .pcard-tag {
    position: absolute; left: 12px; top: 12px; font-size: .68rem; font-weight: 700; letter-spacing: .04em;
    text-transform: uppercase; color: var(--red-deep); background: var(--cream);
    padding: 5px 10px; border-radius: 999px;
  }
  .pcard:hover .pcard-media { transform: translateY(-10px); box-shadow: 0 24px 40px rgba(47,122,58,.18); }
  .pcard:hover .pcard-media img { transform: scale(1.06); }
  .pcard-body { padding: 16px 4px 0; }
  .pcard-body h3 { font-size: .98rem; letter-spacing: -0.01em; line-height: 1.35; transition: color .25s ease; }
  .pcard:hover .pcard-body h3 { color: var(--red); }
  .no-results { text-align: center; color: var(--ink-soft); padding: 40px 0; font-weight: 600; }

  .oem-box { display: flex; justify-content: space-between; align-items: center; gap: 36px; flex-wrap: wrap; }
  .oem-box h2 { color: #fff; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: 12px; }
  .oem-box p { color: rgba(255,255,255,.82); max-width: 520px; }
  .oem-box .btn { flex-shrink: 0; }

  @media (max-width: 900px) { .prod-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .prod-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
    .oem-box { padding: 40px 30px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".pcard");
  const noResults = document.getElementById("no-results");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle("active", b === btn));
      let shown = 0;
      cards.forEach((c) => {
        const match = key === "all" || c.dataset.cat === key;
        c.classList.toggle("is-hidden", !match);
        if (match) shown++;
      });
      if (noResults) noResults.hidden = shown !== 0;
      window.dispatchEvent(new Event("resize"));
    });
  });
</script>
