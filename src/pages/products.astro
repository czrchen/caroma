---
import Layout from "../layouts/Layout.astro";

const filters = [
  { key: "all", label: "All Products" },
  { key: "coffee", label: "Coffee" },
  { key: "tea", label: "Tea" },
  { key: "matcha", label: "Matcha & Japanese" },
  { key: "ginger", label: "Ginger & Wellness" },
  { key: "bundle", label: "Bundles" },
];

const products = [
  { cat: "coffee", name: "Blende White Coffee 3-in-1", img: "/images/products/product-3574722.png", desc: "Smooth Ipoh-style white coffee with creamer and sugar." },
  { cat: "coffee", name: "Instant Coffee Powder 500g", img: "/images/products/product-3882501.png", desc: "Rich instant coffee powder for home and café use." },
  { cat: "coffee", name: "Roasted Coffee Mixture Powder 2kg", img: "/images/products/product-3682061.png", desc: "Bulk roasted coffee blend for food-service brewing." },
  { cat: "coffee", name: "Kopi C Kosong", img: "/images/products/product-3717039.png", desc: "Classic kopi C with evaporated milk, no sugar." },
  { cat: "coffee", name: "Uncang Kopi O Filter Bag", img: "/images/products/product-3717038.png", desc: "Traditional black coffee in convenient filter bags." },
  { cat: "coffee", name: "Hong Kong Style Coffee Powder", img: "/images/products/product-5788817.png", desc: "Bold HK-style coffee for a thick, aromatic cup." },
  { cat: "tea", name: "Black Tea Teadust 1kg", img: "/images/products/product-5949870.png", desc: "Fine black teadust for strong, full-bodied brews." },
  { cat: "tea", name: "Hong Kong Style Milk Tea Powder", img: "/images/products/product-5788819.png", desc: "Creamy, silky Hong Kong-style milk tea premix." },
  { cat: "tea", name: "Hong Kong Style Ice Lemon Tea", img: "/images/products/product-5788818.png", desc: "Refreshing lemon tea — just add water and ice." },
  { cat: "tea", name: "Hong Kong Style Yuan Yang Powder", img: "/images/products/product-5788820.png", desc: "The classic coffee-and-tea Yuan Yang blend." },
  { cat: "tea", name: "Serbuk Teh Tarik Halia", img: "/images/products/product-3717035.png", desc: "Frothy pulled-tea premix with warming ginger." },
  { cat: "tea", name: "Serbuk Teh O Halia", img: "/images/products/product-3717037.png", desc: "Sugared black tea with a gentle ginger kick." },
  { cat: "matcha", name: "Uji Matcha Latte 3-in-1", img: "/images/products/product-6529013.png", desc: "Stone-ground Uji matcha in a creamy latte mix." },
  { cat: "matcha", name: "Uji Genmaicha Latte 3-in-1", img: "/images/products/product-6529043.png", desc: "Toasted-rice green tea latte — nutty and smooth." },
  { cat: "matcha", name: "Uji Hojicha Latte 3-in-1", img: "/images/products/product-6529059.png", desc: "Roasted hojicha latte with a mellow, toasty finish." },
  { cat: "matcha", name: "Pure Green Tea Matcha Powder", img: "/images/products/product-3682004.png", desc: "100% pure matcha for lattes, baking and whisking." },
  { cat: "matcha", name: "Pure Hojicha Roasted Green Tea Powder", img: "/images/products/product-3681998.png", desc: "Pure roasted hojicha powder, low in caffeine." },
  { cat: "matcha", name: "Genmaicha Latte", img: "/images/products/product-5909600.png", desc: "Comforting genmaicha latte, ready in seconds." },
  { cat: "matcha", name: "Genmaicha Powder", img: "/images/products/product-5909571.png", desc: "Pure genmaicha powder for authentic brews." },
  { cat: "ginger", name: "Bentong Ginger with Tea", img: "/images/products/product-3574546.png", desc: "Premium Bentong ginger blended with black tea." },
  { cat: "ginger", name: "Bentong Ginger with Honey Lemon", img: "/images/products/product-3574561.png", desc: "Soothing ginger with honey and zesty lemon." },
  { cat: "ginger", name: "Coconut Water with Bentong Ginger", img: "/images/products/product-3682018.png", desc: "Hydrating coconut water with warming ginger." },
  { cat: "ginger", name: "Honey with Bentong Ginger", img: "/images/products/product-3682017.png", desc: "Pure honey infused with fragrant Bentong ginger." },
  { cat: "ginger", name: "Pure Soilless Bentong Ginger Powder", img: "/images/products/product-3682013.png", desc: "Concentrated soilless Bentong ginger powder." },
  { cat: "ginger", name: "Bentong Ginger with Tea (30's)", img: "/images/products/product-3882412.png", desc: "Family pack of ginger tea — 30 sachets." },
  { cat: "ginger", name: "Bentong Ginger with Honey Lemon (30's)", img: "/images/products/product-3882409.png", desc: "Honey-lemon ginger in a 30-sachet value pack." },
  { cat: "ginger", name: "Organic Soy Powder", img: "/images/products/product-3882511.png", desc: "Wholesome organic soy drink powder." },
  { cat: "bundle", name: "Bundle Set — Teh Tarik", img: "/images/products/product-4530783.png", desc: "Teh tarik gift bundle, ready to share." },
  { cat: "bundle", name: "Twin Pack — Teh Tarik Halia", img: "/images/products/product-4530774.png", desc: "Two packs of ginger teh tarik premix." },
  { cat: "bundle", name: "Twin Set — Teh O Halia", img: "/images/products/product-4530770.png", desc: "Twin pack of sugared ginger black tea." },
  { cat: "bundle", name: "Twin Set — Uncang Kopi O", img: "/images/products/product-4530768.png", desc: "Two boxes of filter-bag black coffee." },
  { cat: "bundle", name: "Twin Set — Kopi C Kosong", img: "/images/products/product-4530766.png", desc: "Twin pack of unsweetened kopi C." },
];
const labels: Record<string, string> = {
  coffee: "Coffee", tea: "Tea", matcha: "Matcha & Japanese",
  ginger: "Ginger & Wellness", bundle: "Bundle",
};
---

<Layout path="/products" title="Products — Caroma Beverages">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Our products</span>
      <h1 class="page-title" data-split>A drink for every moment</h1>
      <p class="page-lead" data-reveal>
        Coffee, tea, Japanese matcha and Bentong ginger — crafted in Malaysia since 1976.
        Filter by category to find your blend.
      </p>
    </div>
  </section>

  <section class="filter-sec">
    <div class="container">
      <div class="filter-bar" data-reveal role="tablist" aria-label="Filter products">
        {filters.map((f, i) => (
          <button class={`filter-btn${i === 0 ? " active" : ""}`} data-filter={f.key}>{f.label}</button>
        ))}
      </div>

      <div class="prod-grid" data-reveal-group>
        {products.map((p) => (
          <article class="pcard" data-cat={p.cat} tabindex="0">
            <div class="pcard-flip">
              <div class="pcard-face pcard-front">
                <div class="pcard-media"><img src={p.img} alt={p.name} loading="lazy" width="320" height="320" /><span class="pcard-tag">{labels[p.cat]}</span></div>
                <h3>{p.name}</h3>
                <span class="flip-hint">Hover for details ↻</span>
              </div>
              <div class="pcard-face pcard-back">
                <span class="back-cat">{labels[p.cat]}</span>
                <h3>{p.name}</h3>
                <p>{p.desc}</p>
                <span class="flip-hint light">↩ flip back</span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <p class="no-results" id="no-results" hidden>No products in this category.</p>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding: 64px 0 36px; }
  .page-title { font-size: clamp(2.4rem, 5.4vw, 3.8rem); margin: 18px 0 18px; letter-spacing: -0.04em; }
  .page-lead { font-size: 1.12rem; color: var(--ink-soft); max-width: 620px; line-height: 1.65; }

  .filter-sec { padding: 10px 0 0; }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 38px; }
  .filter-btn {
    font-family: var(--font-body); font-weight: 600; font-size: .92rem; cursor: pointer;
    padding: 10px 18px; border-radius: 999px; border: 1px solid var(--line-strong);
    background: #fff; color: var(--ink-soft); transition: all .2s ease;
  }
  .filter-btn:hover { border-color: var(--gold); color: var(--ink); }
  .filter-btn.active { background: var(--navy); border-color: var(--navy); color: #fff; }

  .prod-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; }
  .pcard { perspective: 1300px; outline: none; cursor: pointer; }
  .pcard.is-hidden { display: none; }
  .pcard-flip { position: relative; width: 100%; height: 360px; transform-style: preserve-3d; transition: transform .7s cubic-bezier(.2,.8,.25,1); }
  .pcard:hover .pcard-flip, .pcard:focus-within .pcard-flip { transform: rotateY(180deg); }
  .pcard-face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 22px; overflow: hidden; display: flex; flex-direction: column; }
  .pcard-front { background: #fff; border: 1px solid var(--line); padding: 14px; }
  .pcard-front .pcard-media { flex: 1; min-height: 0; position: relative; background: #fff; border-radius: 16px; overflow: hidden; }
  .pcard-front .pcard-media img { width: 100%; height: 100%; object-fit: contain; padding: 10px; }
  .pcard-tag { position: absolute; left: 10px; top: 10px; font-size: .66rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: var(--red-deep); background: var(--cream); padding: 5px 10px; border-radius: 999px; z-index: 1; }
  .pcard-front h3 { font-size: .98rem; line-height: 1.35; margin-top: 12px; }
  .flip-hint { font-size: .66rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); margin-top: 6px; }
  .flip-hint.light { color: rgba(255,255,255,.7); margin-top: 14px; }
  .pcard-back { background: var(--navy); color: #fff; transform: rotateY(180deg); border-top: 4px solid var(--red); padding: 26px 22px; justify-content: center; }
  .back-cat { font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .pcard-back h3 { color: #fff; font-size: 1.2rem; line-height: 1.25; margin: 0 0 10px; }
  .pcard-back p { color: rgba(255,255,255,.84); font-size: .92rem; line-height: 1.5; }
  @media (prefers-reduced-motion: reduce) { .pcard-flip { transition: none; } }
  .no-results { text-align: center; color: var(--ink-soft); padding: 40px 0; font-weight: 600; }

  .oem-box { display: flex; justify-content: space-between; align-items: center; gap: 36px; flex-wrap: wrap; }
  .oem-box h2 { color: #fff; font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: 12px; }
  .oem-box p { color: rgba(255,255,255,.82); max-width: 520px; }
  .oem-box .btn { flex-shrink: 0; }

  @media (max-width: 900px) { .prod-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .prod-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
    .oem-box { padding: 40px 30px; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".pcard");
  const noResults = document.getElementById("no-results");
  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const key = btn.dataset.filter;
      buttons.forEach((b) => b.classList.toggle("active", b === btn));
      let shown = 0;
      cards.forEach((c) => {
        const match = key === "all" || c.dataset.cat === key;
        c.classList.toggle("is-hidden", !match);
        if (match) shown++;
      });
      if (noResults) noResults.hidden = shown !== 0;
      window.dispatchEvent(new Event("resize"));
    });
  });
</script>
